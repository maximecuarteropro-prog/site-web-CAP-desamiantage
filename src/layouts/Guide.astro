---
// Gabarit des pages éditoriales : fil d'Ariane, titre, date de mise à jour, corps, FAQ,
// sources datées, appel à l'action. Produit aussi les données structurées de la page.
import { getImage } from 'astro:assets'
import Base from '@/layouts/Base.astro'
import SiteHeader from '@/components/SiteHeader.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import { ORGANISATION, SITE, absolu } from '@/lib/site'
import partage from '@/assets/hero-retrait-plaque.jpg'

export type Source = { titre: string; url: string; date: string }
export type Question = { question: string; reponse: string }

interface Props {
  titre: string
  description: string
  chemin: string
  rubrique: string
  h1: string
  chapo: string
  publie: string
  misAJour: string
  sources: Source[]
  faq?: Question[]
}

const { titre, description, chemin, rubrique, h1, chapo, publie, misAJour, sources, faq = [] } = Astro.props
const dateLisible = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })

// Même image que l'aperçu de partage (Base.astro) : Google la demande pour un Article.
const image = await getImage({ src: partage, width: 1200, height: 630, fit: 'cover', format: 'jpg' })

const donnees: Record<string, unknown>[] = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: absolu('/') },
      { '@type': 'ListItem', position: 2, name: h1, item: absolu(chemin) },
    ],
  },
  {
    '@type': 'Article',
    '@id': `${absolu(chemin)}#article`,
    headline: h1,
    description,
    inLanguage: 'fr-FR',
    datePublished: publie,
    dateModified: misAJour,
    image: new URL(image.src, SITE.url).href,
    mainEntityOfPage: absolu(chemin),
    author: { '@id': ORGANISATION['@id'] },
    publisher: { '@id': ORGANISATION['@id'] },
    citation: sources.map((s) => s.url),
  },
]
if (faq.length) {
  donnees.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: q.reponse } })),
  })
}
---
<Base titre={titre} description={description} chemin={chemin} type="article" donnees={donnees}>
  <SiteHeader />
  <main class="page-article">
    <article class="article-container">
      <nav class="fil-ariane" aria-label="Fil d'Ariane">
        <ol>
          <li><a href="/">Accueil</a></li>
          <li aria-current="page">{h1}</li>
        </ol>
      </nav>
      <header class="article-head">
        <span class="section-kicker">{rubrique}</span>
        <h1>{h1}</h1>
        <p class="article-chapo">{chapo}</p>
        <p class="article-maj">Mis à jour le <time datetime={misAJour}>{dateLisible(misAJour)}</time> · chaque chiffre est daté et renvoie à sa source.</p>
      </header>
      <div class="article-body">
        <slot />
        {faq.length > 0 && (
          <>
            <h2 id="questions">Questions fréquentes</h2>
            <dl class="faq">
              {faq.map((q) => (
                <>
                  <dt>{q.question}</dt>
                  <dd>{q.reponse}</dd>
                </>
              ))}
            </dl>
          </>
        )}
        <section class="sources" aria-labelledby="titre-sources">
          <h2 id="titre-sources">Sources</h2>
          <ol>
            {sources.map((s) => (
              <li><a href={s.url} rel="noopener">{s.titre}</a>, {s.date}.</li>
            ))}
          </ol>
        </section>
      </div>
    </article>
  </main>
  <section class="article-cta" aria-labelledby="titre-cta">
    <div class="article-cta-inner">
      <div>
        <span class="projects-kicker">Votre chantier</span>
        <h2 id="titre-cta">Un devis d'une entreprise certifiée sous-section 3.</h2>
        <p>Décrivez votre chantier en deux minutes. C'est gratuit et sans engagement.</p>
      </div>
      <a class="hero-cta" href="/#devis"><span>Décrire mon chantier</span><span class="cta-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg></span></a>
    </div>
  </section>
  <SiteFooter />
</Base>
