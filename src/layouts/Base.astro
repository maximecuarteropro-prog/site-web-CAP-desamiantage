---
// Squelette commun : balises de référencement, données structurées, police et styles globaux.
import { getImage } from 'astro:assets'
import { SITE, ORGANISATION, SITE_WEB, absolu } from '@/lib/site'
import partage from '@/assets/hero-retrait-plaque.jpg'
import '@/index.css'
import '@/App.css'

interface Props {
  titre: string
  description: string
  chemin: string
  type?: 'website' | 'article'
  donnees?: Record<string, unknown>[]
  indexable?: boolean
  apercu?: ImageMetadata // image de partage propre à la page (sinon la photo du hero)
}

const { titre, description, chemin, type = 'website', donnees = [], indexable = true, apercu = partage } = Astro.props
const canonique = absolu(chemin)
const imagePartage = await getImage({ src: apercu, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
const graphe = { '@context': 'https://schema.org', '@graph': [ORGANISATION, SITE_WEB, ...donnees] }
import archivoLatin from '@/assets/fonts/archivo-latin-wght-normal.woff2?url'
import Analytics from '@vercel/analytics/astro'
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#151611" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={new URL(imagePartage.src, SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(graphe)} />
    <!-- Page d'arrivée sur le site, jointe à la demande de devis pour savoir quel guide amène des demandes. -->
    <script is:inline>try { sessionStorage.getItem('cap-page-entree') || sessionStorage.setItem('cap-page-entree', location.pathname) } catch (e) {}</script>
  </head>
  <body>
    <slot />
    <!-- Mesure d'audience Vercel, sans cookie : pas de bandeau de consentement nécessaire. -->
    <Analytics />
  </body>
</html>
