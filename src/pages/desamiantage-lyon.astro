---
import ZoneDevis from '@/layouts/ZoneDevis.astro'
import AppelDevis from '@/components/AppelDevis.astro'
import BlocPro from '@/components/BlocPro.astro'

// Page orientée devis : la personne cherche un pro. Chiffres : Insee RP 2023 (LOG T3, LOG T8) et Sitadel (permis de
// démolir autorisés en 2025, hors annulés), relevés le 4 nov. 2026. Règle de la Métropole relue le même jour.
const sources = [
  { titre: 'Insee, dossier complet de la commune de Lyon, recensement 2023, tableaux LOG T3 et LOG T8', url: 'https://www.insee.fr/fr/statistiques/2011101?geo=COM-69123', date: 'consulté le 4 novembre 2026' },
  { titre: 'Insee, dossier complet France entière, recensement 2023', url: 'https://www.insee.fr/fr/statistiques/2011101?geo=FE-1', date: 'consulté le 4 novembre 2026' },
  { titre: 'SDES, base Sitadel, liste des permis de démolir', url: 'https://www.data.gouv.fr/datasets/689c42fa521ccf80ce954f83', date: 'permis autorisés en 2025, hors permis annulés, comptage du 4 novembre 2026' },
  { titre: 'Métropole de Lyon, « Trouver une déchèterie »', url: 'https://www.grandlyon.com/mes-services-au-quotidien/gerer-ses-dechets/trouver-une-decheterie', date: 'mise à jour le 29 septembre 2026' },
  { titre: 'Métropole de Lyon, règlement de collecte des déchets ménagers et assimilés, partie V-2', url: 'https://www.grandlyon.com/fileadmin/user_upload/media/pdf/proprete/reglement-collecte-dma.pdf', date: 'édition 2024' },
  { titre: 'Métropole de Lyon, note d’information sur les déchets d’amiante lié des ménages', url: 'https://www.grandlyon.com/fileadmin/user_upload/media/pdf/proprete/amiante_00_noteinformation_2026.pdf', date: 'fichier du 7 mai 2026' },
  { titre: 'ADEME, « Que faire de mes déchets : fibrociment »', url: 'https://quefairedemesdechets.ademe.fr/dechet/fibro-ciment/', date: 'mise à jour le 1er octobre 2026' },
  { titre: 'Service-public.fr, fiche F288 « Amiante dans les bâtiments »', url: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F288', date: 'vérifiée le 13 octobre 2026' },
  { titre: 'Code de la santé publique, article R1334-29-7 (état amiante à la vente)', url: 'https://www.legifrance.gouv.fr/codes/section_lc/LEGITEXT000006072665/LEGISCTA000024117147', date: 'version en vigueur depuis le 1er février 2012' },
  { titre: 'Code du travail, article L4412-2 (recherche d’amiante avant travaux)', url: 'https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000033013763', date: 'version en vigueur depuis le 10 août 2016' },
  { titre: 'Code du travail, article R4412-129 (recours à une entreprise certifiée)', url: 'https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000025818905', date: 'version en vigueur depuis le 1er juillet 2012' },
  { titre: 'Code du travail, article R4412-137 (transmission du plan de retrait)', url: 'https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000046882710', date: 'version en vigueur depuis le 1er février 2023' },
]

const faq = [
  { question: 'Comment obtenir un devis de désamiantage à Lyon ?', reponse: 'Répondez aux questions en haut de cette page et indiquez le code postal du chantier. L’un de nos pros certifiés sous-section 3 vous rappelle sous 24 h, puis se déplace pour un devis détaillé, gratuit et sans engagement.' },
  { question: 'Puis-je déposer du fibrociment moi-même à Lyon ?', reponse: 'Pas en déchèterie. La Métropole prévoit, pour les ménages qui y résident, un dépôt gratuit en site agréé jusqu’à 200 kg sur 12 mois, sur dossier. Les flocages, colles et dalles vinyles en sont exclus, et l’ADEME déconseille fortement le retrait par soi-même.' },
  { question: 'Combien coûte un désamiantage à Lyon ?', reponse: 'Nous ne publions pas de prix propre à Lyon. Nos relevés nationaux donnent 25 à 80 €/m² pour des dalles de sol et 60 à 250 €/m² pour un flocage. L’étage, l’accès et le confinement font varier le coût : seul un devis après visite donne le prix de votre chantier.' },
  { question: 'Combien de temps prévoir en copropriété à Lyon ?', reponse: 'Comptez le repérage, le devis et le vote en assemblée générale, puis au moins trente jours entre le dépôt du plan de retrait et le début des travaux (code du travail, art. R4412-137). Ce délai passe à 8 jours en cas d’urgence liée à un sinistre.' },
]
---
<ZoneDevis
  titre="Désamiantage à Lyon : devis gratuit d’un pro certifié"
  description="Copropriété, rénovation ou démolition à Lyon : l’un de nos pros certifiés vous rappelle sous 24 h, se déplace et vous remet un devis détaillé gratuit."
  chemin="/desamiantage-lyon"
  h1="Désamiantage à Lyon : votre devis gratuit"
  chapo="Appartement à rénover, parties communes ou bâtiment à démolir : l’un de nos pros certifiés sous-section 3 vous rappelle sous 24 h, puis se déplace pour un devis."
  exempleCodePostal="69003"
  publie="2026-11-04"
  misAJour="2026-11-04"
  sources={sources}
  faq={faq}
>
  <section class="zone-bloc">
    <h2>Ce qui vous amène à Lyon</h2>
    <div class="article-body">
      <ul class="zone-cartes">
        <li><h3>Vous rénovez un appartement</h3><p>À Lyon, 96,1 % des logements sont des appartements, contre 44,3 % en France (Insee, 2023). Avant de refaire un sol, une salle de bains ou des conduits dans un immeuble construit avant 1997, le repérage amiante est obligatoire dès qu’un pro intervient (code du travail, art. L4412-2). Dalles et colles amiantées relèvent d’un pro certifié : la Métropole les exclut de son dispositif de dépôt.</p></li>
        <li><h3>Vous gérez une copropriété</h3><p>Le syndic tient le dossier technique amiante des parties communes (service-public.fr, fiche F288). Pour une colonne, un conduit ou un faux plafond, le pro visite l’immeuble, puis remet un devis poste par poste que le conseil syndical peut soumettre au vote de l’assemblée générale.</p></li>
        <li><h3>Vous vendez</h3><p>Un permis de construire antérieur au 1er juillet 1997 impose de remettre un état amiante à l’acheteur (code de la santé publique, art. R1334-29-7). Cet état n’oblige pas à retirer quoi que ce soit, mais un devis vous évite de négocier sans chiffre.</p></li>
        <li><h3>Vous démolissez</h3><p>Lyon a compté 50 permis de démolir autorisés en 2025, et le Rhône 232 (Sitadel). Le retrait passe avant la démolition : repérage, plan de retrait, puis chantier. Intégrez ces étapes dès le début de votre calendrier.</p></li>
      </ul>
    </div>
  </section>

  <BlocPro titre="Un pro que vous pouvez vérifier">
    <p>Seuls les pros certifiés peuvent retirer ou encapsuler ces matériaux (art. R4412-129). Tous nos pros le sont, et le vôtre se présente dès son appel. Voici <a href="/certification-sous-section-3">comment vérifier une certification sous-section 3</a>.</p>
  </BlocPro>

  <section class="zone-bloc">
    <h2>Comment se passe le chantier</h2>
    <div class="article-body">
      <ol class="zone-cartes zone-etapes">
        <li><strong>L’appel, sous 24 h</strong> Le pro précise le matériau, l’accès et l’étage.</li>
        <li><strong>La visite et le devis</strong> Il évalue le chantier et détaille chaque poste, sans engagement.</li>
        <li><strong>Le plan de retrait</strong> Il le dépose auprès de l’administration au moins trente jours avant le chantier, ou 8 jours en cas d’urgence liée à un sinistre (art. R4412-137).</li>
        <li><strong>Le retrait et l’évacuation</strong> Il retire les matériaux sous protection, puis les évacue avec un bordereau de suivi. Demandez-en une copie à la fin du chantier.</li>
      </ol>
      <p>Les déchèteries de la Métropole n’acceptent pas l’amiante. Pour le fibrociment des ménages, elle prévoit un dépôt gratuit en site agréé, sur dossier, jusqu’à 200 kg sur 12 mois : l’ensachage et le transport restent à votre charge, et les déchets d’un chantier confié à un pro en sont exclus. L’ADEME écrit que le retrait par soi-même est « fortement déconseillé ». Les règles générales sont dans notre guide <a href="/dechetterie-amiante">déchetterie et amiante</a>.</p>
      <AppelDevis accroche="Appartement, immeuble ou démolition : l’un de nos pros certifiés vient voir votre chantier." />
    </div>
  </section>

  <section class="zone-bloc">
    <h2>Quel budget prévoir</h2>
    <div class="article-body">
      <p>Nous ne publions pas de prix propre à Lyon. Nos relevés nationaux du 29 octobre 2026 donnent 25 à 80 €/m² pour des dalles de sol, 60 à 250 €/m² pour un flocage et le plus souvent 40 à 100 €/m² pour une toiture en fibrociment. Le détail est sur notre page du <a href="/prix-desamiantage">prix du désamiantage au m²</a>. Seul un devis après visite donne le prix de votre chantier.</p>
      <p>Au 4 novembre 2026, nous n’avons pas trouvé d’aide locale ouverte pour le retrait de l’amiante à Lyon. Renseignez-vous auprès de la Métropole avant de signer.</p>
    </div>
  </section>

  <section class="zone-bloc">
    <h2>Le bâti lyonnais en chiffres</h2>
    <div class="article-body">
      <p>À Lyon, 68,0 % des résidences principales ont été achevées avant 1991, à peine moins qu’en France (68,5 %), dont 22,3 % entre 1946 et 1970 et 22,5 % entre 1971 et 1990 (Insee, 2023). L’amiante est interdit depuis le 1er janvier 1997, et l’Insee ne coupe pas à cette date. Ces chiffres ne disent pas qu’un immeuble contient de l’amiante : seul un repérage le dit.</p>
    </div>
  </section>
</ZoneDevis>
